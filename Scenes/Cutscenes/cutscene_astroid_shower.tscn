[sub_resource type="GDScript" id="GDScript_u1ik3"]
script/source = "extends Node2D
##
##  Cutscene Asteroid-Shower
## 
##

# ──────────────────────────────────────────────────────────────
# NODES (per Drag-&-Drop im Inspector neu zuweisen)
# ──────────────────────────────────────────────────────────────
@onready var background : Sprite2D = $Background
@onready var foreground : Sprite2D = $Foreground


@onready var layers     : Array[Sprite2D] = [background, foreground]

var layer_scales : Array[float] = [0.5, 1.0]

# Basisscrollspeed (Pixel pro Sekunde nach links)
@export var scroll_speed : float = -38.0


const TILE_SIZE := Vector2(900, 900)

# ──────────────────────────────────────────────────────────────
# LEBENSCYCLE
# ──────────────────────────────────────────────────────────────
func _ready() -> void:
	#reset()
	pass
		
func _process(delta: float) -> void:
	_scroll_layers(delta)
	
# ──────────────────────────────────────────────────────────────
# HELPER
# ──────────────────────────────────────────────────────────────
func _scroll_layers(delta: float) -> void:
	for i in layers.size():
		var layer := layers[i]
		var rect  := layer.region_rect
		rect.position.x -= scroll_speed * layer_scales[i] * delta
		if rect.position.x <= -TILE_SIZE.x:
			rect.position.x += TILE_SIZE.x
		layer.region_rect = rect
		
func reset() -> void:
	for layer in layers:
		layer.region_rect = Rect2(Vector2.ZERO, TILE_SIZE)
		
"

